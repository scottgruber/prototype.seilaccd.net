<!DOCTYPE html>
<html lang="en-US">

 <!-- @include "partials/_head.html" -->
<style type="text/css">
      main {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 1rem;
        max-width: 1200px;
        margin-inline: auto;
      }

      .palette {
        border: 1px solid var(--laccd-border, #1c4993);
        border-radius: 12px;
        padding: 1rem 1rem 1.5rem;
        background: var(--sei-surface, #fff);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06);
      }

      .group-title {
        display: block;
        margin: .5rem 0 1rem;
        font-size: var(--font-size-display);
      }

      .swatch-set {
        display: grid;
        grid-template-columns: repeat(9, minmax(120px, 1fr));
        gap: 1rem;
      }

      /* 3-up sets (paper/sand/brown) */
      .swatch-set.is-3 {
        grid-template-columns: repeat(3, minmax(100px, 1fr));
      }

      .swatch {
        display: grid;
        grid-template:
          "chip" 140px
          "meta" auto / 1fr;
        place-items: center;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        padding: .75rem .75rem 1rem;
        background: #fff;
      }

      .swatch .chip {
        grid-area: chip;
        height: 120px;
        width: 120px;
        border-radius: 50%;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06);
      }

      .swatch .meta {
        grid-area: meta;
        text-align: center;
        font-size: .85rem;
        line-height: 1.3;
        margin-top: .5rem;
      }

      .swatch h4 {
        margin: .25rem 0 .2rem;
        font-size: .9rem;
        letter-spacing: .02em;
      }

      /* LACCD palette layout */
      .swatch-set.is-laccd {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }

      .swatch.is-laccd .chip {
        width: 140px;
        height: 140px;
      }

      .swatch .meta code {
        font-size: .8rem;
        display: inline-block;
        margin-top: .35rem;
        color: var(--sei-text-muted);
      }

      .heading-green-strong {
        color: var(--laccd-green-dark);
      }
      .heading-green {
        color: var(--laccd-green);
      }
      .heading-green-soft {
        color: color-mix(in srgb, var(--laccd-green-light) 45%, var(--laccd-green-dark) 55%);
      }

      .intro {
        max-width: 70ch;
        color: var(--sei-text-muted);
      }

      @media (prefers-color-scheme: dark), :root[data-theme="dark"] {
        .palette {
          background: color-mix(in srgb, var(--laccd-blue-dark) 30%, black);
          border-color: color-mix(in srgb, var(--laccd-blue) 60%, black);
          color: color-mix(in srgb, white 90%, var(--laccd-blue-light) 10%);
        }
        .swatch {
          background: color-mix(in srgb, var(--laccd-blue-dark) 15%, var(--laccd-sand));
          border-color: color-mix(in srgb, var(--laccd-blue) 60%, black);
        }
        .swatch .meta {
          color: color-mix(in srgb, white 90%, var(--laccd-blue-light) 10%);
        }
        .swatch .meta code {
          color: color-mix(in srgb, white 80%, var(--laccd-blue) 20%);
        }
      }

      @media (max-width: 1100px) {
        .swatch-set {
          grid-template-columns: repeat(6, minmax(120px, 1fr));
        }
      }

      @media (max-width: 800px) {
        .swatch-set {
          grid-template-columns: repeat(3, minmax(120px, 1fr));
        }
      }

    </style>
  <body class="colors-page">
    <!-- @include "partials/_header.kit" -->

    <!-- @include "partials/_nav.html" -->

    <main>
      <h1 class="heading-green-strong">LACCD Color Palette</h1>
      <p class="intro">Official district colors pulled from the LACCD palette are below. Headings use the three green values for quick contrast checks: dark for primary titles, mid for subheads, and a balanced mix of light/dark for tertiary labels.</p>

